# EVCC Configuration
EVCC_URL=https://demo.evcc.io
EVCC_PASSWORD=

# Email Server Configuration
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
# auto = SSL (SMTPS) on port 465, STARTTLS otherwise; or set starttls | ssl | none
SMTP_SECURITY=auto
# Login username (optional, defaults to SENDER_EMAIL)
SMTP_USERNAME=
# Display name in the email From header (optional, defaults to SENDER_NAME)
SMTP_FROM_NAME=
SENDER_EMAIL=sender@example.com
SENDER_PASSWORD=secret_password
RECIPIENT_EMAIL=recipient@example.com

# Sender Details (for the PDF)
SENDER_NAME=John Doe
SENDER_STREET=Sample Street 123
SENDER_CITY=12345 Sample City

# Localization (en_US.UTF-8, de_DE.UTF-8, etc.)
LOCALE=de_DE.UTF-8

# PDF table columns (comma-separated, in order).
# Available: start_time,end_time,loadpoint,loadpoint_idx,vehicle,odometer,meter_start,meter_end,energy,duration,price
# Default if unset:
PDF_COLUMNS=start_time,end_time,loadpoint,vehicle,energy,duration,price

# Filter whitelists (empty = include all). Names must match the evcc names exactly.
#FILTER_VEHICLES=Nissan Leaf,Tesla Model 3
#FILTER_LOADPOINTS=Garage